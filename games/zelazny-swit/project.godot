; Godot 4.4+ / Android landscape
config_version=5

[application]
config/name="Żelazny Świt"
config/version="0.1.5"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Mobilna gra akcji RPG 3D. Wioska Brzeziny, wojownik, handlarz i kowal."
config/use_custom_user_dir=true
config/custom_user_dir_name="ZelaznySwit"
config/icon="res://icon.svg"

[autoload]
Diagnostics="*res://scripts/diagnostics.gd"
GameState="*res://scripts/game_state.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.13, 0.19, 0.25, 1)
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60

[debug]
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=3
